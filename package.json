{
  "name": "next-intl-hlpr",
  "displayName": "next-intl-hlpr",
  "publisher": "felipestanzani",
  "description": "Highlights missing translations in next-intl JSON files and shows missing languages on hover",
  "version": "0.0.5-beta.1",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/felipestanzani/next-intl-hlpr.git"
  },
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "next-intl",
    "i18n",
    "translations",
    "json",
    "typescript"
  ],
  "activationEvents": [
    "onLanguage:json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Next Intl Helper",
      "properties": {
        "nextIntlHlpr.detectConfig": {
          "type": "boolean",
          "default": true,
          "description": "Whether to automatically detect next-intl configuration from next.config.js/ts and i18n/request.ts"
        },
        "nextIntlHlpr.configPath": {
          "type": "string",
          "description": "Path to next-intl configuration files (if not auto-detected). Should point to the directory containing next.config.js/ts and i18n/request.ts"
        },
        "nextIntlHlpr.requestPath": {
          "type": "string",
          "description": "Path to the request.ts file (if not in i18n/request.ts). This is where next-intl message loading is configured."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.js --production",
    "compile": "node esbuild.js",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "test": "vscode-test",
    "test:unit": "mocha \"out/test/utils/*.test.js\" \"out/test/simple.test.js\" \"out/test/demo.test.js\" --require ./test-setup.js --ui bdd",
    "test:diagnostics": "mocha \"out/test/services/diagnosticService.test.js\" --require ./test-setup.js --ui bdd",
    "test:coverage": "nyc npm run test:unit",
    "pretest": "tsc -p ./ && npm run lint",
    "test:watch": "npm run compile && npm run test:unit -- --watch"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.15.18",
    "@types/sinon": "^17.0.3",
    "@types/vscode": "^1.96.2",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "@vscode/test-cli": "^0.0.8",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.20.2",
    "eslint": "^9.26.0",
    "jsonc-parser": "^3.3.1",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "prettier": "3.5.3",
    "sinon": "^17.0.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@formatjs/fast-memoize": "^2.2.7",
    "@schummar/icu-type-parser": "1.22.2",
    "eslint-config-molindo": "^8.0.0",
    "intl-messageformat": "^10.7.16"
  },
  "prettier": "eslint-config-molindo/.prettierrc.json"
}